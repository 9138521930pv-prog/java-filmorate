Function "JSON_AGG" not found; SQL statement:
SELECT
    f.id,
    f.name,
    f.description,
    f.release_date,
    f.duration,
    f.mpa_id,
    COALESCE(
        JSON_AGG(
            JSON_BUILD_OBJECT('id', g.id, 'name', g.name)
        ) FILTER (WHERE g.id IS NOT NULL),
        '[]'::json
    ) AS genre,
    COALESCE(
        STRING_AGG(l.user_id::text, ','),
        ''
    ) AS likes,
    JSON_BUILD_OBJECT('id', m.id, 'name', m.name) AS mpa
FROM films f
LEFT JOIN film_genres fg ON f.id = fg.film_id
LEFT JOIN genres g ON fg.genre_id = g.id
LEFT JOIN likes l ON f.id = l.film_id
LEFT JOIN mpa m ON f.mpa_id = m.id
JOIN (
    SELECT film_id, COUNT(user_id) AS likes_count
    FROM likes
    GROUP BY film_id
) lc ON f.id = lc.film_id
GROUP BY f.id, f.name, f.description, f.release_date, f.duration, f.mpa_id, m.id, m.name
ORDER BY lc.likes_count DESC
